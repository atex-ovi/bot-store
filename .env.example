# ============================
# 🧑‍💼 Admin Configuration
# ============================
# The WhatsApp JID of the admin (your main account)
ADMIN_JID=62xxxxxxxxxxx@s.whatsapp.net

# ============================
# 💳 E-Wallet Account Numbers
# ============================
# These numbers represent your wallet accounts for receiving payments
PAY_OVO=08xxxxxxxxxx
PAY_SHOPEEPAY=08xxxxxxxxxx
PAY_DANA=08xxxxxxxxxx
PAY_GOPAY=08xxxxxxxxxx

# ============================
# 🔗 Auto Payment Links
# ============================
# Optional: Payment links for each e-wallet (used for QR or auto redirect)
PAY_OVO_URL=https://ovo.id/payment/abcdef12345
PAY_SHOPEEPAY_URL=https://shopeepay.link/abcdef12345
PAY_DANA_URL=https://link.dana.id/minta/qr/123456abcdef
PAY_GOPAY_URL=https://gopay.link/u/abcdef12345

# ============================
# 🧾 Payment Recipient
# ============================
# The name that appears on your payment accounts
PAY_RECIPIENT_NAME=Atex Ovi

# ============================
# 💡 Developer Note
# ============================
# You can modify or extend this template to support
# additional payment methods or custom identifiers.
# Copy this file as `.env` before running the bot.